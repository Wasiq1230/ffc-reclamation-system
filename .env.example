# ==============================================================================
# FFC Valve Reclamation Management System — Production Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# NEVER commit the actual .env file or real secrets to version control.

# Application Environment: 'development', 'staging', or 'production'
APP_ENV=production
APP_NAME="FFC Valve Reclamation Management System"
APP_VERSION="1.0.0"

# Application Base URL
APP_BASE_URL=https://reclamation.ffc.com.pk

# API Prefix
API_PREFIX=/api

# Database Connection (e.g. PostgreSQL in production or SQLite in development)
DATABASE_URL=sqlite:///./ffc_valves.db
# Example PostgreSQL: postgresql://ffc_user:SECURE_PASSWORD@db.internal:5432/ffc_valves

# JWT Authentication Signing Secret (Generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_64_CHARACTER_RANDOM_HEX_STRING_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Account & Security Policies
ACCOUNT_APPROVAL_REQUIRED=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGINS=https://reclamation.ffc.com.pk,http://localhost:3000

# File Storage Paths (Absolute or relative to backend)
STORAGE_DIR=backend/storage
CERTIFICATES_DIR=backend/storage/certificates
DOCUMENTS_DIR=backend/storage/documents
PHOTOS_DIR=backend/storage/photos

# Email Verification Provider (SMTP or API)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.ffc.com.pk
# SMTP_PORT=587
# SMTP_USER=notifications@ffc.com.pk
# SMTP_PASSWORD=PLACEHOLDER_SMTP_PASSWORD
# EMAIL_FROM_ADDRESS=notifications@ffc.com.pk

# SMS / OTP Provider (e.g. Telco Gateway / Twilio / Local SMS aggregator)
# SMS_PROVIDER=local_gateway
# SMS_PROVIDER_URL=https://api.sms-gateway.pk/v1/send
# SMS_PROVIDER_API_KEY=PLACEHOLDER_SMS_KEY
# SMS_SENDER_ID=FFC-VALVES
